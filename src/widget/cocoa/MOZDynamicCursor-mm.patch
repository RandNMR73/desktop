diff --git a/widget/cocoa/MOZDynamicCursor.mm b/widget/cocoa/MOZDynamicCursor.mm
index f4b25f640e6d1946d05dff90b6fb450f701d4e7c..3fdd62f224f7d39e50a3ec48f9dce216d1b27700 100644
--- a/widget/cocoa/MOZDynamicCursor.mm
+++ b/widget/cocoa/MOZDynamicCursor.mm
@@ -33,6 +33,10 @@ static constexpr nsCursor kCustomCursor = eCursorCount;
 + (NSCursor*)busyButClickableCursor;
 @end
 
+@interface MOZDynamicCursor ()
+- (void)reapplyIfReplaced;
+@end
+
 @implementation MOZDynamicCursor
 
 + (MOZDynamicCursor*)sharedInstance {
@@ -223,14 +227,52 @@ static constexpr nsCursor kCustomCursor = eCursorCount;
     mCursors = [[NSMutableDictionary alloc] initWithCapacity:25];
     mCurrentCursor = [[NSCursor arrowCursor] retain];
     mCurrentCursorType = eCursor_standard;
+    // Gecko does not update the cursor on every pointer move (for example
+    // right after a swipe gesture), so re-apply ours on each move as native
+    // views do in -cursorUpdate:. The monitor lives as long as this
+    // singleton. Drags deliver mouseDragged:, not mouseMoved:, so drag
+    // cursors are left alone.
+    [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskMouseMoved
+                                          handler:^NSEvent*(NSEvent* aEvent) {
+                                            [self reapplyIfReplaced];
+                                            return aEvent;
+                                          }];
   }
   return self;
 }
 
+// The window server's edge resize cursors replace ours without the pointer
+// leaving ChildView's cursor rect, and without NSCursor.currentCursor
+// changing, so -set is not called again and the resize arrow stays until
+// Gecko asks for a different cursor (for example over the compact-mode
+// sidebar, which is revealed from the screen edge in its own popup window).
+// Native views re-apply their cursor as the pointer moves over them; do the
+// same whenever the pointer is clear of the window's resize edges.
+- (void)reapplyIfReplaced {
+  if (mCurrentCursorType == eCursor_none || !mCurrentCursor) {
+    return;
+  }
+  // Leave the window server's resize cursor alone near any resizable
+  // window's edges.
+  NSPoint location = NSEvent.mouseLocation;
+  for (NSWindow* window in NSApp.windows) {
+    if (!window.isVisible ||
+        !(window.styleMask & NSWindowStyleMaskResizable)) {
+      continue;
+    }
+    if (NSPointInRect(location, NSInsetRect(window.frame, -8, -8)) &&
+        !NSPointInRect(location, NSInsetRect(window.frame, 8, 8))) {
+      return;
+    }
+  }
+  [mCurrentCursor set];
+}
+
 - (void)setNonCustomCursor:(const nsIWidget::Cursor&)aCursor {
   [self setCursor:[self cursorWithType:aCursor.mDefaultCursor]
              type:aCursor.mDefaultCursor];
   sCurrentCursor = aCursor;
+  [self reapplyIfReplaced];
 }
 
 - (void)setCursor:(NSCursor*)aMacCursor type:(nsCursor)aType {
