+void RenderCompositorNative::SetSurfaceOpacity(wr::NativeSurfaceId aId,
+                                               float aOpacity) {
+  auto surfaceCursor = mSurfaces.find(aId);
+  if (surfaceCursor == mSurfaces.end()) {
+    return;
+  }
+  for (auto& entry : surfaceCursor->second.mNativeLayers) {
+    entry.second->SetOpacity(aOpacity);
+  }
+}
