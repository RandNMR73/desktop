+bool Axis::CanOverscroll() const {
+  if (CanScroll()) {
+    return true;
+  }
+  if (!StaticPrefs::apz_overscroll_zero_range_enabled() ||
+      GetCompositionLength() <= 0 ||
+      !mAsyncPanZoomController->IsZero(GetPageLength() -
+                                       GetCompositionLength())) {
+    return false;
+  }
+  auto overflow = GetOverflow();
+  return overflow == StyleOverflow::Auto || overflow == StyleOverflow::Scroll ||
+         (overflow == StyleOverflow::Visible &&
+          mAsyncPanZoomController->IsRootContent());
+}
