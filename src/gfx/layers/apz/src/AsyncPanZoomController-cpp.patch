+struct AsyncPanZoomController::ArcElasticScrollState {
+  ArcElasticGestureModel model;
+  ParentLayerPoint units{1, 1};
+  ArcElasticGestureModel::Vector delta;
+  TimeStamp eventTime;
+  int64_t nativeTime = 0;
+  bool processing = false;
+  bool updated = false;
+  bool momentum = false;
+  ArcNativeVelocityFilter nativeVelocity;
+  Maybe<ArcNativeMomentumModel> nativeMomentum;
+  TimeStamp nativeReturnTime;
+  TimeStamp nativeSampleTime;
+  ArcElasticGestureModel::Vector offsetBefore;
+  float backingScale = 1;
+  bool nativeVertical = false;
+  bool nativeMoved = false;
+  bool nativeOwnsMomentum = false;
+};
+
+bool AsyncPanZoomController::PrepareArcPan(const PanGestureInput& aEvent) {
+  const auto fallback = [&] {
+    RecursiveMutexAutoLock lock(mRecursiveMutex);
+    if (ArcReturnActive()) {
+      if (mX.IsOverscrolled()) mX.StartOverscrollAnimation(mX.GetVelocity());
+      if (mY.IsOverscrolled()) mY.StartOverscrollAnimation(mY.GetVelocity());
+    }
+    mArcElastic = nullptr;
+    return false;
+  };
+  if (!(aEvent.mNativeBackingScale > 0) || aEvent.mNativeEventTimeUs <= 0 ||
+      aEvent.mDeltaType != PanGestureInput::PANDELTA_PIXEL) {
+    return fallback();
+  }
+  const float scale = aEvent.mNativeBackingScale;
+  const auto xUnit =
+      ToParentLayerCoordinates(ScreenPoint(scale, 0), aEvent.mPanStartPoint);
+  const auto yUnit =
+      ToParentLayerCoordinates(ScreenPoint(0, scale), aEvent.mPanStartPoint);
+  if (!std::isfinite(xUnit.x) || !std::isfinite(yUnit.y) || xUnit.x <= 0 ||
+      yUnit.y <= 0 || std::abs(xUnit.y) > 0.0001f ||
+      std::abs(yUnit.x) > 0.0001f) {
+    return fallback();
+  }
+  const ScreenPoint nativeDelta(
+      aEvent.mNativePanDisplacement.x * aEvent.mUserDeltaMultiplierX,
+      aEvent.mNativePanDisplacement.y * aEvent.mUserDeltaMultiplierY);
+  const auto delta =
+      ToParentLayerCoordinates(nativeDelta * scale, aEvent.mPanStartPoint);
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  if (!mArcElastic) {
+    if (IsPhysicallyOverscrolled()) {
+      return false;
+    }
+    mArcElastic = MakeUnique<ArcElasticScrollState>();
+    mArcElastic->model.Begin(aEvent.IsMomentum());
+  }
+  mArcElastic->units = {xUnit.x, yUnit.y};
+  mArcElastic->backingScale = scale;
+  mArcElastic->delta = {delta.x / xUnit.x, delta.y / yUnit.y};
+  if (auto* block = GetCurrentPanGestureBlock()) {
+    const auto allowed = block->GetAllowedScrollDirections();
+    if (!allowed.contains(ScrollDirection::eHorizontal))
+      mArcElastic->delta.x = 0;
+    if (!allowed.contains(ScrollDirection::eVertical)) mArcElastic->delta.y = 0;
+  }
+  mArcElastic->eventTime = aEvent.mTimeStamp;
+  mArcElastic->nativeTime = aEvent.mNativeEventTimeUs;
+  mArcElastic->momentum = aEvent.IsMomentum();
+  return true;
+}
+
+void AsyncPanZoomController::ArcPanChain(const PanGestureInput& aEvent,
+                                         ArcPanPhase aPhase) {
+  if (!GetCurrentPanGestureBlock()) {
+    return;
+  }
+  const auto chain = GetCurrentPanGestureBlock()->GetOverscrollHandoffChain();
+  for (uint32_t i = 0; i < chain->Length(); ++i) {
+    auto* apzc = chain->GetApzcAtIndex(i).get();
+    if (apzc->IsDestroyed()) {
+      continue;
+    }
+    if (aPhase == ArcPanPhase::Finish) {
+      apzc->FinishArcPan();
+      continue;
+    }
+    if (!apzc->PrepareArcPan(aEvent)) {
+      continue;
+    }
+    RecursiveMutexAutoLock lock(apzc->mRecursiveMutex);
+    auto& arc = *apzc->mArcElastic;
+    switch (aPhase) {
+      case ArcPanPhase::Begin: {
+        arc.nativeMomentum.reset();
+        arc.nativeVelocity.Reset();
+        arc.nativeMoved = false;
+        arc.nativeOwnsMomentum = false;
+        arc.model.Begin(false);
+        const auto bounds = apzc->ArcBounds();
+        arc.nativeVertical =
+            apzc->mScrollMetadata.IsChromeDocument() &&
+            bounds.maximum.x == 0 && !bounds.userScrollableX &&
+            bounds.userScrollableY &&
+            bounds.overscrollable &&
+            apzc->mY.OverscrollBehaviorAllowsOverscrollEffect();
+        break;
+      }
+      case ArcPanPhase::Momentum:
+        arc.model.Begin(true);
+        break;
+      case ArcPanPhase::Prepare:
+        arc.processing = true;
+        arc.updated = false;
+        arc.offsetBefore = apzc->ArcBounds().offset;
+        if (arc.nativeVertical && !arc.momentum) {
+          arc.nativeVelocity.Add(arc.delta.y, arc.nativeTime / 1e6);
+        }
+        break;
+      case ArcPanPhase::End:
+        apzc->EndArcPan();
+        if (arc.nativeMomentum && apzc->mState != OVERSCROLL_ANIMATION) {
+          apzc->StartOverscrollAnimation({}, apzc->GetOverscrollSideBits());
+        }
+        break;
+      case ArcPanPhase::Finish:
+        MOZ_ASSERT_UNREACHABLE("Handled before preparing the event");
+        break;
+    }
+  }
+}
+
+ArcElasticGestureModel::Bounds AsyncPanZoomController::ArcBounds() const {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  MOZ_ASSERT(mArcElastic);
+  ArcElasticGestureModel::Bounds bounds;
+  const auto& units = mArcElastic->units;
+  bounds.maximum = {
+      std::max(0.0f, float((mX.GetPageLength() - mX.GetCompositionLength()) /
+                           units.x)),
+      std::max(0.0f, float((mY.GetPageLength() - mY.GetCompositionLength()) /
+                           units.y))};
+  bounds.offset = {(mX.GetOrigin() - mX.GetPageStart()) / units.x,
+                   (mY.GetOrigin() - mY.GetPageStart()) / units.y};
+  if (mX.IsScrolledToStart())
+    bounds.offset.x = 0;
+  else if (mX.IsScrolledToEnd())
+    bounds.offset.x = bounds.maximum.x;
+  if (mY.IsScrolledToStart())
+    bounds.offset.y = 0;
+  else if (mY.IsScrolledToEnd())
+    bounds.offset.y = bounds.maximum.y;
+  bounds.userScrollableX = mX.CanOverscroll() && !mX.IsAxisLocked();
+  bounds.userScrollableY = mY.CanOverscroll() && !mY.IsAxisLocked();
+  bounds.overscrollable = StaticPrefs::apz_overscroll_enabled() &&
+                          !mScrollMetadata.GetDisregardedDirection();
+  return bounds;
+}
+
+bool AsyncPanZoomController::IsArcPanActive() const {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  return mArcElastic && mArcElastic->processing;
+}
+
+void AsyncPanZoomController::ApplyArcOverscroll(ParentLayerPoint& aUnused) {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  MOZ_ASSERT(IsArcPanActive());
+  auto& arc = *mArcElastic;
+  const auto directions = GetOverscrollableDirections();
+  arc.model.Update(arc.delta,
+                   {aUnused.x / arc.units.x, aUnused.y / arc.units.y},
+                   arc.nativeTime, arc.momentum, ArcBounds(),
+                   {mX.OverscrollBehaviorAllowsOverscrollEffect(),
+                    mY.OverscrollBehaviorAllowsOverscrollEffect()});
+  arc.updated = true;
+  SyncArcStretch();
+  if (directions.contains(ScrollDirection::eHorizontal)) aUnused.x = 0;
+  if (directions.contains(ScrollDirection::eVertical)) aUnused.y = 0;
+  ScheduleComposite();
+}
+
+void AsyncPanZoomController::SyncArcStretch() {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  const auto stretch = mArcElastic->model.Stretch();
+  mX.RestoreOverscroll(stretch.x * mArcElastic->units.x);
+  mY.RestoreOverscroll(stretch.y * mArcElastic->units.y);
+}
+
+void AsyncPanZoomController::FinishArcPan() {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  if (!IsArcPanActive()) {
+    return;
+  }
+  auto& arc = *mArcElastic;
+  if (arc.nativeOwnsMomentum && arc.momentum) {
+    // The display sampler owns this single-axis animation. Re-applying the
+    // platform's momentum delta to the drag model would alter its stretch
+    // between compositor samples, even after AttemptScroll consumed the delta.
+    arc.processing = false;
+    return;
+  }
+  if (!arc.updated) {
+    arc.model.Update(arc.delta, {}, arc.nativeTime, arc.momentum, ArcBounds(),
+                     {mX.OverscrollBehaviorAllowsOverscrollEffect(),
+                      mY.OverscrollBehaviorAllowsOverscrollEffect()});
+  }
+  const auto correction = arc.model.Reconcile(ArcBounds());
+  if (!correction.IsZero() && Metrics().GetZoom() != CSSToParentLayerScale(0)) {
+    ScrollBy(ParentLayerPoint(correction.x * arc.units.x,
+                              correction.y * arc.units.y) /
+             Metrics().GetZoom());
+    ScheduleCompositeAndMaybeRepaint();
+  }
+  SyncArcStretch();
+  if (arc.nativeVertical) {
+    if (arc.model.Stretch().x != 0) {
+      arc.nativeVertical = false;
+    } else if (ArcBounds().offset != arc.offsetBefore ||
+               arc.model.Stretch().y != 0) {
+      arc.nativeMoved = true;
+    }
+  }
+  arc.processing = false;
+  if (ArcReturnActive() && mState != OVERSCROLL_ANIMATION) {
+    StartOverscrollAnimation({}, GetOverscrollSideBits());
+  }
+}
+
+bool AsyncPanZoomController::ArcReturnActive() const {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  return mArcElastic &&
+         (mArcElastic->nativeMomentum ||
+          mArcElastic->model.GetState() == ArcElasticGestureModel::State::Returning);
+}
+
+bool AsyncPanZoomController::SampleArcReturn() {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  MOZ_ASSERT(ArcReturnActive());
+  if (NativeArcMomentumActive()) {
+    return SampleNativeArcMomentum();
+  }
+  auto& arc = *mArcElastic;
+  const int64_t time =
+      arc.nativeTime +
+      int64_t((GetFrameTime().Time() - arc.eventTime).ToMicroseconds());
+  const bool alive = arc.model.Sample(time);
+  SyncArcStretch();
+  if (!alive) {
+    mX.SetVelocity(0);
+    mY.SetVelocity(0);
+  }
+  return alive;
+}
+
+void AsyncPanZoomController::EndArcPan() {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  if (!mArcElastic || mArcElastic->nativeOwnsMomentum) {
+    return;
+  }
+  auto& arc = *mArcElastic;
+  const auto bounds = ArcBounds();
+  arc.model.End(arc.nativeTime, bounds);
+  if (arc.nativeVertical &&
+      (arc.nativeMoved || arc.model.Stretch().y != 0)) {
+    arc.nativeOwnsMomentum = true;
+    arc.nativeVelocity.ResetIfOutOfDate(arc.nativeTime / 1e6);
+    arc.nativeMomentum.emplace(bounds.offset.y + arc.model.Stretch().y,
+                               arc.nativeVelocity.Velocity(), 0,
+                               bounds.maximum.y);
+    arc.nativeReturnTime = arc.eventTime;
+    arc.nativeSampleTime = arc.eventTime;
+    if (arc.nativeMomentum->Duration() <= 0) {
+      arc.nativeMomentum.reset();
+    }
+  }
+}
+
+bool AsyncPanZoomController::NativeArcMomentumActive() const {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  return mArcElastic && mArcElastic->nativeMomentum.isSome();
+}
+
+bool AsyncPanZoomController::OwnsNativeArcMomentum() const {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  return mArcElastic && mArcElastic->nativeOwnsMomentum;
+}
+
+bool AsyncPanZoomController::UsesNativeArcMomentum() const {
+  RecursiveMutexAutoLock lock(mRecursiveMutex);
+  return mArcElastic && mArcElastic->nativeVertical;
+}
+
+bool AsyncPanZoomController::SampleNativeArcMomentum() {
+  mRecursiveMutex.AssertCurrentThreadIn();
+  auto& arc = *mArcElastic;
+  MOZ_ASSERT(arc.nativeMomentum);
+  // Native NSScrollView predicts one refresh beyond the CVDisplayLink target.
+  // Use the compositor's sample time and actual display interval, not now or
+  // an assumed 60Hz period. Synthetic APZ tests default to no extra prediction.
+  APZCTreeManager* treeManager = GetApzcTreeManager();
+  const TimeDuration prediction = treeManager
+                                      ? treeManager->GetNativeScrollFrameInterval()
+                                      : TimeDuration();
+  const TimeStamp sampleTime = mLastSampleTime.Time() + prediction;
+  const double elapsed = std::max(
+      0.0, (sampleTime - arc.nativeReturnTime).ToSeconds());
+  const bool alive = elapsed < arc.nativeMomentum->Duration();
+  const auto bounds = ArcBounds();
+  double position = alive ? arc.nativeMomentum->Position(elapsed)
+                          : arc.nativeMomentum->Destination();
+  if (!alive) {
+    position = std::clamp(position, 0.0, double(bounds.maximum.y));
+  }
+  position = std::floor(position * arc.backingScale) / arc.backingScale;
+  const double offset = std::clamp(position, 0.0, double(bounds.maximum.y));
+  const double sampleMilliseconds =
+      (sampleTime - arc.nativeSampleTime).ToMilliseconds();
+  if (alive && sampleMilliseconds > 0) {
+    // Keep displayport prediction in step with native-owned free scrolling.
+    // Axis velocities use parent-layer pixels per millisecond.
+    mX.SetVelocity(0);
+    mY.SetVelocity((offset - bounds.offset.y) * arc.units.y /
+                  sampleMilliseconds);
+  }
+  arc.nativeSampleTime = sampleTime;
+  if (Metrics().GetZoom() != CSSToParentLayerScale(0)) {
+    ScrollBy(ParentLayerPoint(0, (offset - bounds.offset.y) * arc.units.y) /
+             Metrics().GetZoom());
+  }
+  arc.model.RestoreStretch({0, float(position - offset)});
+  if (!alive) {
+    arc.nativeMomentum.reset();
+    arc.nativeVelocity.Reset();
+    arc.nativeMoved = false;
+    arc.model.Reset();
+    mX.SetVelocity(0);
+    mY.SetVelocity(0);
+  }
+  SyncArcStretch();
+  return alive;
+}
+
+bool AsyncPanZoomController::ShouldDeferArcPagePan(
+    const PanGestureInput& aEvent) const {
+  if (!(aEvent.mNativeBackingScale > 0) || aEvent.mNativeEventTimeUs <= 0 ||
+      aEvent.mDeltaType != PanGestureInput::PANDELTA_PIXEL ||
+      aEvent.mPanDisplacement != ScreenPoint{} ||
+      aEvent.mNativePanDisplacement != ScreenPoint{}) {
+    return false;
+  }
+  if (mDeferredArcPagePan) {
+    return true;
+  }
+  const auto* block = GetCurrentPanGestureBlock();
+  if (!block) {
+    return false;
+  }
+  const auto chain = block->GetOverscrollHandoffChain();
+  for (uint32_t i = 0; i < chain->Length(); ++i) {
+    const auto apzc = chain->GetApzcAtIndex(i);
+    RecursiveMutexAutoLock lock(apzc->mRecursiveMutex);
+    if (!apzc->IsDestroyed() && !apzc->mScrollMetadata.IsChromeDocument() &&
+        apzc->ArcReturnActive()) {
+      return true;
+    }
+  }
+  return false;
+}
