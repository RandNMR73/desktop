+DeviceColor ToDeviceColor(const StyleAbsoluteColor& aColor,
+                          const nsIFrame* aFrame) {
+  if (gfxPlatform::UsesNativeDisplayP3() &&
+      !zen::nsZenBoostsBackend::HasStyleColorFilter(aFrame)) {
+    // Preserve the source gamut through conversion. Going through nscolor
+    // first clips to sRGB and permanently loses saturated P3 components.
+    auto translated = aColor.ToColorSpace(StyleColorSpace::DisplayP3);
+    const auto inRange = [](float value) {
+      return value >= 0.0f && value <= 1.0f;
+    };
+    if (!inRange(translated.components._0) ||
+        !inRange(translated.components._1) ||
+        !inRange(translated.components._2)) {
+      switch (StaticPrefs::layout_css_gamut_mapping_method()) {
+        case 1:
+          translated = Servo_GamutMapColorUsingBinarySearchMINDE(
+              &aColor, StyleColorSpace::DisplayP3);
+          break;
+        case 2:
+          translated = Servo_GamutMapColorUsingRaytrace(
+              &aColor, StyleColorSpace::DisplayP3);
+          break;
+      }
+    }
+    const auto component = [](float value) {
+      return std::isfinite(value) ? std::clamp(value, 0.0f, 1.0f) : 0.0f;
+    };
+    return {component(translated.components._0),
+            component(translated.components._1),
+            component(translated.components._2), component(translated.alpha)};
+  }
+  return ToDeviceColor(aColor.ToColor(aFrame));
 }

