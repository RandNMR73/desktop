+
+/// Zen: a premultiplied colour composited at an opacity-group's opacity.
+fn scale_by_opacity(color: PremultipliedColorF, opacity: f32) -> PremultipliedColorF {
+    if opacity >= 1.0 {
+        return color;
+    }
+    PremultipliedColorF {
+        r: color.r * opacity,
+        g: color.g * opacity,
+        b: color.b * opacity,
+        a: color.a * opacity,
+    }
+}
