+    /// Zen: start an opacity group. Everything added until `pop_opacity_group`
+    /// goes into one atomic slice (so the group's own content never spans
+    /// slices that would each be faded separately), composited at `opacity`.
+    pub fn push_opacity_group(
+        &mut self,
+        opacity: PropertyBinding<f32>,
+        spatial_node_index: SpatialNodeIndex,
+        lock_raster_scale: bool,
+        iframe_clip: Option<ClipId>,
+    ) {
+        let mut slice = PrimarySlice::new(SliceFlags::IS_ATOMIC, iframe_clip, None);
+        slice.kind = SliceKind::Atomic { prim_list: PrimitiveList::empty() };
+        slice.opacity = Some(opacity);
+        slice.group_spatial_node = Some(spatial_node_index);
+        slice.lock_raster_scale = lock_raster_scale;
+        self.primary_slices.push(slice);
+    }
+
+    /// Zen: set the opacity of the opacity group being built.
+    pub fn set_group_opacity(&mut self, opacity: PropertyBinding<f32>) {
+        if let Some(slice) = self.primary_slices.last_mut() {
+            slice.opacity = Some(opacity);
+        }
+    }
+
+    /// Zen: end the opacity group started by `push_opacity_group`.
+    pub fn pop_opacity_group(&mut self, iframe_clip: Option<ClipId>) {
+        self.add_tile_cache_barrier(SliceFlags::empty(), iframe_clip);
+    }
+
