+static const JSClass WindowConstructorCacheClass = {
+    "XrayWindowConstructors", JSCLASS_HAS_RESERVED_SLOTS(1)};
+
+static JSObject* GetWindowConstructorCache(JSObject* holder, JSObject* target) {
+  const Value& cached = JS::GetReservedSlot(holder, WindowConstructorCacheSlot);
+  if (!cached.isObject()) {
+    return nullptr;
+  }
+  JSObject* cache = &cached.toObject();
+  JSObject* constructor =
+      UncheckedUnwrap(&JS::GetReservedSlot(cache, 0).toObject());
+  // WindowProxy identity survives navigation; constructor identity does not.
+  if (!constructor || JS::GetNonCCWObjectGlobal(constructor) != target) {
+    JS::SetReservedSlot(holder, WindowConstructorCacheSlot, UndefinedValue());
+    return nullptr;
+  }
+  return cache;
+}
+
+// Keep the Window-only cache path out of ordinary DOM property resolution.
+static MOZ_NEVER_INLINE bool
+ResolveCachedWindowConstructor(JSContext *cx, HandleObject wrapper,
+                               HandleObject target, HandleObject holder,
+                               HandleId id,
+                               MutableHandle<Maybe<PropertyDescriptor>> desc) {
+  desc.reset();
+  RootedObject constructorCache(cx, GetWindowConstructorCache(holder, target));
+  if (!constructorCache) {
+    return true;
+  }
+  Rooted<Maybe<PropertyDescriptor>> cachedDesc(cx);
+  if (!JS_GetOwnPropertyDescriptorById(cx, constructorCache, id, &cachedDesc)) {
+    return false;
+  }
+  if (cachedDesc.isNothing()) {
+    return true;
+  }
+  // An extension override still takes precedence over a native cache hit.
+  RootedObject expando(cx);
+  if (!DOMXrayTraits::singleton.getExpandoObject(cx, target, wrapper,
+                                                 &expando)) {
+    return false;
+  }
+  if (expando) {
+    JSAutoRealm ar(cx, expando);
+    JS_MarkCrossZoneId(cx, id);
+    if (!JS_GetOwnPropertyDescriptorById(cx, expando, id, desc)) {
+      return false;
+    }
+  }
+  if (desc.isSome()) {
+    return JS_WrapPropertyDescriptor(cx, desc);
+  }
+  desc.set(cachedDesc);
+  return true;
+}
