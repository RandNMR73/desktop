+static bool XrayExpandoHasOwnProperty(JSObject* xray, jsid id) {
+  Value holder = GetProxyReservedSlot(xray, GetXrayJitInfo()->xrayHolderSlot);
+  if (!holder.isObject()) {
+    return false;
+  }
+  Value expando = holder.toObject().as<NativeObject>().getFixedSlot(
+      GetXrayJitInfo()->holderExpandoSlot);
+  if (!expando.isObject()) {
+    return false;
+  }
+  return UncheckedUnwrap(&expando.toObject())
+      ->as<NativeObject>()
+      .containsPure(id);
+}
