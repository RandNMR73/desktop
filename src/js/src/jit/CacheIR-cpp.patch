 static const size_t SHAPE_CONTAINER_SLOT = 0;

+bool jit::XrayExpandoMatchesShape(JSObject* xray, JSObject* shapeWrapper) {
+  JS::XrayJitInfo* info = GetXrayJitInfo();
+  Value holder = GetProxyReservedSlot(xray, info->xrayHolderSlot);
+  if (!holder.isObject()) {
+    return !shapeWrapper;
+  }
+  Value expando = holder.toObject().as<NativeObject>().getFixedSlot(
+      info->holderExpandoSlot);
+  if (!expando.isObject()) {
+    return !shapeWrapper;
+  }
+  if (!shapeWrapper) {
+    return false;
+  }
+  Value container = GetProxyPrivate(shapeWrapper);
+  if (!container.isObject()) {
+    return false;
+  }
+  Value shape = container.toObject().as<NativeObject>().getFixedSlot(
+      SHAPE_CONTAINER_SLOT);
+  auto* nativeExpando =
+      &UncheckedUnwrap(&expando.toObject())->as<NativeObject>();
+  return nativeExpando->shape() == shape.toGCThing() &&
+         nativeExpando->getFixedSlot(info->expandoProtoSlot).isUndefined();
+}
