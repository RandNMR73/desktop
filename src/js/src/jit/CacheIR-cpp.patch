+Shape* jit::GetShapeWrapperContents(JSObject* wrapper) {
+  const Value& target = GetProxyPrivate(wrapper);
+  if (!target.isObject()) {
+    return nullptr;
+  }
+  auto& container = target.toObject().as<NativeObject>();
+  MOZ_ASSERT(container.getClass() == &shapeContainerClass);
+  return static_cast<Shape*>(
+      container.getReservedSlot(SHAPE_CONTAINER_SLOT).toGCThing());
+}
