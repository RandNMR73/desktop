+static bool TryFoldingXrayDOMProperties(JSContext* cx, ICFallbackStub* fallback,
+                                        JSScript* script, ICScript* icScript,
+                                        bool* folded) {
+  *folded = false;
+  ICEntry* icEntry = icScript->icEntryForStub(fallback);
+  ICCacheIRStub* first = icEntry->firstStub()->toCacheIRStub();
+  const CacheIRStubInfo* info = first->stubInfo();
+  mozilla::Maybe<uint32_t> entriesOffset;
+  CacheIRReader reader(info);
+  while (reader.more()) {
+    CacheOp op = reader.readOp();
+    if (op == CacheOp::GuardXrayDOMProperty) {
+      auto [objId, offset] = reader.argsForGuardXrayDOMProperty();
+      if (entriesOffset.isSome()) {
+        return true;
+      }
+      entriesOffset.emplace(offset);
+    } else {
+      reader.skip(CacheIROpInfos[size_t(op)].argLength);
+    }
+  }
+  if (entriesOffset.isNothing()) {
+    return true;
+  }
+
+  uint32_t count = 0;
+  uint32_t totalEntered = 0;
+  for (ICCacheIRStub* stub = first; stub; stub = stub->nextCacheIR()) {
+    if (stub->stubInfo() != info) {
+      return true;
+    }
+    totalEntered += stub->enteredCount();
+    size_t offset = 0;
+    for (uint32_t index = 0; info->fieldType(index) != StubField::Type::Limit;
+         index++) {
+      StubField::Type type = info->fieldType(index);
+      if (offset == *entriesOffset) {
+        MOZ_ASSERT(type == StubField::Type::JSObject);
+      } else if (StubField::sizeIsInt64(type)) {
+        if (info->getStubRawInt64(first->stubDataStart(), offset) !=
+            info->getStubRawInt64(stub->stubDataStart(), offset)) {
+          return true;
+        }
+      } else if (info->getStubRawWord(first->stubDataStart(), offset) !=
+                 info->getStubRawWord(stub->stubDataStart(), offset)) {
+        return true;
+      }
+      offset += StubField::sizeInBytes(type);
+    }
+    JSObject* entries =
+        info->getStubField<StubField::Type::JSObject>(stub, *entriesOffset);
+    count += entries->as<ListObject>().length();
+    if (count > 64) {
+      return true;
+    }
+  }
+  Rooted<ListObject*> entries(cx);
+  {
+    gc::AutoSuppressGC suppressGC(cx);
+    entries = ListObject::create(cx);
+    if (!entries) {
+      return false;
+    }
+    for (ICCacheIRStub* stub = first; stub; stub = stub->nextCacheIR()) {
+      JSObject* old =
+          info->getStubField<StubField::Type::JSObject>(stub, *entriesOffset);
+      const auto& oldEntries = old->as<ListObject>();
+      for (uint32_t i = 0; i < oldEntries.length(); i++) {
+        if (!entries->append(cx, oldEntries.get(i))) {
+          return false;
+        }
+      }
+    }
+  }
+
+  CacheKind kind = info->kind();
+  CacheIRWriter writer(cx);
+  for (uint32_t i = 0; i < NumInputsForCacheKind(kind); i++) {
+    writer.setInputOperandId(i);
+  }
+  CacheIRReader source(info);
+  CacheIRCloner cloner(first);
+  while (source.more()) {
+    CacheOp op = source.readOp();
+    if (op == CacheOp::GuardXrayDOMProperty) {
+      auto [objId, offset] = source.argsForGuardXrayDOMProperty();
+      MOZ_ASSERT(offset == *entriesOffset);
+      writer.guardXrayDOMProperty(objId, entries);
+    } else {
+      cloner.cloneOp(op, source, writer);
+    }
+  }
+  if (writer.tooLarge()) {
+    return true;
+  }
+  MaybeMarkingLock lock;
+  ICAttachResult result = AttachBaselineCacheIRStubLocked(
+      cx, writer, kind, script, icScript, fallback, DiscardExistingStubs::Yes,
+      "XrayDOMFold", lock);
+  if (result == ICAttachResult::OOM) {
+    ReportOutOfMemory(cx);
+    return false;
+  }
+  MOZ_RELEASE_ASSERT(result == ICAttachResult::Attached);
+  icEntry->firstStub()->setEnteredCount(totalEntered);
+  *folded = true;
+  return true;
+}
