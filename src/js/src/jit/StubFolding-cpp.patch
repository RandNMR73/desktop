+bool js::jit::AddToXrayDOMPropertyStub(JSContext* cx,
+                                       const CacheIRWriter& writer,
+                                       const CacheIRStubInfo* info,
+                                       const uint8_t* stubData) {
+  if (info->codeLength() != writer.codeLength() ||
+      memcmp(info->code(), writer.codeStart(), writer.codeLength()) != 0) {
+    return false;
+  }
+
+  mozilla::Maybe<uint32_t> entriesOffset;
+  CacheIRReader reader(info);
+  while (reader.more()) {
+    CacheOp op = reader.readOp();
+    if (op == CacheOp::GuardXrayDOMProperty) {
+      auto [objId, offset] = reader.argsForGuardXrayDOMProperty();
+      if (entriesOffset.isSome()) {
+        return false;
+      }
+      entriesOffset.emplace(offset);
+    } else {
+      reader.skip(CacheIROpInfos[size_t(op)].argLength);
+    }
+  }
+  if (entriesOffset.isNothing()) {
+    return false;
+  }
+
+  size_t offset = 0;
+  for (uint32_t i = 0; i < writer.numStubFields(); i++) {
+    const StubField& field = writer.stubField(i);
+    StubField::Type type = field.type();
+    if (info->fieldType(i) != type) {
+      return false;
+    }
+    if (offset == *entriesOffset) {
+      MOZ_ASSERT(type == StubField::Type::JSObject);
+    } else if (StubField::sizeIsInt64(type)) {
+      if (uint64_t(info->getStubRawInt64(stubData, offset)) !=
+          field.asInt64()) {
+        return false;
+      }
+    } else if (info->getStubRawWord(stubData, offset) != field.asWord()) {
+      return false;
+    }
+    offset += StubField::sizeInBytes(type);
+  }
+  MOZ_ASSERT(info->fieldType(writer.numStubFields()) == StubField::Type::Limit);
+
+  JSObject* oldObject = reinterpret_cast<JSObject*>(
+      info->getStubRawWord(stubData, *entriesOffset));
+  gc::ReadBarrier(oldObject);
+  Rooted<ListObject*> entries(cx, &oldObject->as<ListObject>());
+  StubField field =
+      writer.readStubField(*entriesOffset, StubField::Type::JSObject);
+  Rooted<ListObject*> incoming(
+      cx, &reinterpret_cast<JSObject*>(field.asWord())->as<ListObject>());
+  if (entries == incoming || entries->length() + incoming->length() > 64) {
+    return false;
+  }
+  gc::AutoSuppressGC suppressGC(cx);
+  for (uint32_t i = 0; i < incoming->length(); i++) {
+    if (!entries->append(cx, incoming->get(i))) {
+      cx->recoverFromOutOfMemory();
+      return false;
+    }
+  }
+  return true;
+}
