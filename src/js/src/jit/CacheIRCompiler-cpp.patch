+bool js::jit::GuardXrayDOMProperty(JSObject* obj, JSObject* entriesObject) {
+  AutoUnsafeCallWithABI unsafe;
+  JS::XrayJitInfo* info = GetXrayJitInfo();
+  JSObject* target = Wrapper::wrappedObject(obj);
+  if (!target->is<NativeObject>()) {
+    return false;
+  }
+  const auto& entries = entriesObject->as<ListObject>();
+  for (uint32_t i = 0; i < entries.length(); i++) {
+    const auto& entry = entries.getAs<ListObject>(i);
+    if (entry.get(0).toPrivate() != target->getClass() ||
+        !XrayExpandoMatchesShape(obj, entry.get(1).toObjectOrNull())) {
+      continue;
+    }
+    bool matches = true;
+    for (uint32_t j = 2; j < entry.length(); j += 2) {
+      JSObject* proto = &entry.get(j).toObject();
+      if (!proto->is<ProxyObject>() ||
+          !info->isCrossCompartmentXray(GetProxyHandler(proto)) ||
+          !XrayExpandoMatchesShape(proto, entry.get(j + 1).toObjectOrNull())) {
+        matches = false;
+        break;
+      }
+      JSObject* protoTarget = Wrapper::wrappedObject(proto);
+      if (!protoTarget->is<NativeObject>() ||
+          protoTarget->as<NativeObject>().realm() !=
+              target->as<NativeObject>().realm()) {
+        matches = false;
+        break;
+      }
+    }
+    if (matches) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool CacheIRCompiler::emitGuardXrayDOMProperty(ObjOperandId objId,
+                                               uint32_t entriesOffset) {
+  Register obj = allocator.useRegister(masm, objId);
+  AutoScratchRegister entries(allocator, masm);
+  AutoScratchRegister scratch(allocator, masm);
+  FailurePath* failure;
+  if (!addFailurePath(&failure)) {
+    return false;
+  }
+  emitLoadStubField(StubFieldOffset(entriesOffset, StubField::Type::JSObject),
+                    entries);
+  LiveRegisterSet save = liveVolatileRegs();
+  masm.PushRegsInMask(save);
+  masm.setupUnalignedABICall(scratch);
+  masm.passABIArg(obj);
+  masm.passABIArg(entries);
+  using Fn = bool (*)(JSObject*, JSObject*);
+  masm.callWithABI<Fn, jit::GuardXrayDOMProperty>();
+  masm.storeCallBoolResult(scratch);
+  LiveRegisterSet ignore;
+  ignore.add(scratch);
+  masm.PopRegsInMaskIgnore(save, ignore);
+  masm.branchTest32(Assembler::Zero, scratch, scratch, failure->label());
+  return true;
+}
