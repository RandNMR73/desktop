--- a/browser/themes/shared/urlbar/view-proton.css
+++ b/browser/themes/shared/urlbar/view-proton.css
@@ -12,11 +12,7 @@

   --urlbarView-small-font-size: 0.85em;

-  --urlbarView-results-padding: 7px;
-  /* The view's own margin, which urlbar.css also derives the joint
-     background's outsets from. */
-  --urlbarView-margin-block: 0px;
-  --urlbarView-margin-inline: var(--urlbarView-results-padding);
+  --urlbarView-results-padding: 8px;
   --urlbarView-row-gutter: var(--space-xxsmall);
   --urlbarview-row-padding-block: 6px;
   --urlbarView-row-padding-inline: var(--urlbar-icon-padding);
@@ -95,8 +91,13 @@
   display: none;
   text-shadow: none;
   overflow: clip;
-  margin-inline: var(--urlbarView-margin-inline);
-  width: calc(100% - 2 * var(--urlbarView-margin-inline));
+  margin-inline: var(--urlbarView-results-padding);
+  width: calc(100% - 2 * var(--urlbarView-results-padding));
+
+  .urlbar[open] > & {
+    display: flex;
+    flex-direction: column;
+  }

   /* The gap under the input sits outside the scrollport, so a row scrolling
      past it doesn't paint over the input's border edge. */
@@ -187,7 +188,6 @@
       min-height: var(--urlbarview-row-min-height);
     }
     :root[uidensity="touch"] & {
-      padding-block: 11px;
     }
   }

@@ -2043,3 +2043,39 @@
   margin-block-start: var(--urlbar-padding-block);
   background: var(--urlbarView-tail150-canvas-background);
 }
+
+#urlbar[open] .urlbarView-row[zen-split-view] .urlbarView-favicon {
+  display: none !important;
+}
+
+#urlbar[open] .zen-split-result-icons {
+  display: flex;
+  flex: 0 0 30px;
+  height: 30px;
+  margin-inline: -3px 5px;
+  gap: 1px;
+  overflow: hidden;
+  border-radius: 4px;
+
+  > span {
+    flex: 1 1 0;
+    min-width: 0;
+    display: grid;
+    place-items: center;
+    background: rgb(255 255 255 / 0.05);
+  }
+
+  img {
+    width: 9px;
+    height: 9px;
+    object-fit: contain;
+  }
+}
+
+#urlbar[open] .urlbarView-row[selected] .zen-split-result-icons > span {
+  background: white;
+}
+
+#urlbar[open] .zen-split-result-divider {
+  opacity: 0.25;
+}
