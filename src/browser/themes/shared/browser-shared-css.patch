-  #toolbar-menubar[autohide]:not([inactive]) ~ :is(#TabsToolbar, #nav-bar) > & {
-    visibility: hidden;
+  /* Zen: no in-window menubar on macOS. A general-sibling selector over the
+   * toolbox's children makes every insertion into the toolbox restyle all
+   * later toolbars (the whole tab strip, ~2300 elements, ~12 ms); keep it out
+   * of the macOS cascade so moving the address bar costs what it changes. */
+  @media not (-moz-platform: macos) {
+    #toolbar-menubar[autohide]:not([inactive]) ~ :is(#TabsToolbar, #nav-bar) > & {
+      visibility: hidden;
+    }
   }
 
