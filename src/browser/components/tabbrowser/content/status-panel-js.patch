+      if (busy && text == this._zenLinkAtLoad) {
+        text = "";
+      } else if (/^https?:\/\//.test(text)) {
+        // Arc's status pill shows the bare address ("www.youtube.com/watch…"
+        // for an https link), without the scheme.
+        text = text.replace(/^https?:\/\//, "");
+      }
+    }
+
+    // Progress updates must not repeatedly mutate an already hidden panel.
+    if (!text && !this.isVisible) {
+      return;
+    }
+
