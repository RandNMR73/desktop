@@ -32,16 +32,44 @@ var StatusPanel = {
     let text;
     let type;
     let types = ["overLink"];
-    if (XULBrowserWindow.busyUI) {
-      types.push("status");
+    if (Services.prefs.getBoolPref("zen.view.show-load-status", false)) {
+      if (XULBrowserWindow.busyUI) {
+        types.push("status");
