+      types.push("defaultStatus");
     }
-    types.push("defaultStatus");
     for (type of types) {
       if ((text = XULBrowserWindow[type])) {
         break;
       }
     }
 
+    // Arc drops the hovered link once the page it opens starts loading; Zen
+    // kept the clicked URL pinned bottom-left for the whole load. Hide the
+    // link that was under the pointer when loading began; any other link
+    // hovered during the load still shows.
+    const busy = XULBrowserWindow.busyUI;
+    if (busy && !this._zenWasBusy) {
+      this._zenLinkAtLoad = XULBrowserWindow.overLink;
+    } else if (!busy) {
+      this._zenLinkAtLoad = null;
