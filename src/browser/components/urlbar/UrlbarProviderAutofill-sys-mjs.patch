@@ -559,4 +560,29 @@
       addCallback(this, this._autofillData.fallbackResult);
     }
+    // Keep the original text searchable beneath an HTTP(S) completion. This
+    // uses the existing default engine without fetching remote suggestions.
+    if (
+      queryContext.keywordEnabled &&
+      !queryContext.searchMode &&
+      !queryContext.restrictSource &&
