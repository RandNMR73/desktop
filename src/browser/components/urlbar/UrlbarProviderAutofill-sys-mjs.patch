+          source: lazy.UrlbarShared.RESULT_SOURCE.SEARCH,
+          heuristic: false,
+          suggestedIndex: 1,
+          payload: {
+            engine: engine.name,
+            icon: lazy.UrlbarShared.ICON.SEARCH_GLASS,
+            query: queryContext.searchString,
