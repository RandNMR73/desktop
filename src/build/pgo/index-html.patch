+  // Speedometer's progress counter can lag its final result. Check the actual
+  // iteration/suite/step records, and only the suites enabled by default.
+  function speedometerCompletion(w) {
+    if (w.location.hash != "#summary") return null;
+    const client = w.benchmarkClient;
+    const defaults = w.Suites.filter(suite => suite.tags.includes("default"));
+    const enabled = w.Suites.filter(suite => !suite.disabled);
+    const expectedIterations = 10; // resources/params.mjs default, unchanged URL.
+    const expectedSuites = Object.fromEntries(defaults.map(suite =>
+      [suite.name, suite.tests.map(test => test.name)]));
+    const sameNames = (actual, expected) => actual.length === expected.length &&
+      actual.every(name => expected.includes(name));
+    const steps = defaults.reduce((count, suite) => count + suite.tests.length, 0);
+    if (defaults.length !== 20 || steps !== 58 ||
+        !sameNames(enabled.map(suite => suite.name), Object.keys(expectedSuites)) ||
+        client?.suitesCount !== defaults.length || client.stepCount !== steps * expectedIterations ||
+        client._isRunning || !client._hasResults ||
+        !w.document.getElementById("summary")?.classList.contains("valid")) {
+      throw new Error("Speedometer failed or changed its default training configuration");
+    }
+    const records = client._measuredValuesList;
+    if (!Array.isArray(records) || records.length !== expectedIterations) {
+      throw new Error("Speedometer did not finish every iteration");
+    }
+    const finite = value => typeof value === "number" && Number.isFinite(value) && value >= 0;
+    const iterations = records.map(record => {
+      if (!finite(record.score) || record.score === 0 ||
+          !sameNames(Object.keys(record.tests || {}), Object.keys(expectedSuites))) {
+        throw new Error("Speedometer has missing or invalid suite results");
+      }
+      return Object.fromEntries(defaults.map(suite => {
+        const result = record.tests[suite.name];
+        const names = Object.keys(result.tests || {});
+        if (!finite(result.total) || !sameNames(names, expectedSuites[suite.name]) ||
+            names.some(name => !finite(result.tests[name].total) ||
+              !finite(result.tests[name].tests?.Sync) || !finite(result.tests[name].tests?.Async))) {
+          throw new Error(`Speedometer has missing or invalid steps: ${suite.name}`);
+        }
+        return [suite.name, names];
+      }));
+    });
+    return { expectedIterations, expectedSuites, iterations, stepCount: client.stepCount };
+  }
