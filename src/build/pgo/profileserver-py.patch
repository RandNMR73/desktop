+def validate_training_result(record, token):
+    """Require the default Speedometer workload, not a URL or progress counter."""
+    if not isinstance(record, dict) or record.get("token") != token:
+        raise ValueError("Missing training result for this run")
+    if record.get("version") != 1 or record.get("status") != "complete":
+        raise ValueError("Training failed: %s" % record.get("error", "incomplete result"))
+    result = record.get("speedometer")
+    if not isinstance(result, dict) or result.get("expectedIterations") != 10:
+        raise ValueError("Speedometer did not use its 10 default iterations")
+    suites = result.get("expectedSuites")
+    if not isinstance(suites, dict) or suites != SPEEDOMETER_DEFAULT_STEPS:
+        raise ValueError("Speedometer did not use its 20 default suites")
+    for name, steps in suites.items():
+        if (not isinstance(name, str) or not name or not isinstance(steps, list)
+                or not steps or any(not isinstance(step, str) or not step for step in steps)
+                or len(set(steps)) != len(steps)):
+            raise ValueError("Invalid Speedometer suite/step manifest")
+    if sum(map(len, suites.values())) != 58 or result.get("stepCount") != 580:
+        raise ValueError("Speedometer default workload changed")
+    iterations = result.get("iterations")
+    if not isinstance(iterations, list) or len(iterations) != 10:
+        raise ValueError("Speedometer iteration results are incomplete")
+    for iteration in iterations:
+        if not isinstance(iteration, dict) or iteration.keys() != suites.keys():
+            raise ValueError("Speedometer suite results are incomplete")
+        for name, expected in suites.items():
+            actual = iteration[name]
+            if (not isinstance(actual, list) or len(actual) != len(expected)
+                    or any(not isinstance(step, str) for step in actual)
+                    or set(actual) != set(expected)):
+                raise ValueError("Speedometer step results are incomplete: %s" % name)
+
+
+def preserve_mapped_directory_slashes(server):
+    # MozHttpd joins mapped URL components without their final slash. For the
+    # nested Speedometer dashboard this causes a relative directory redirect
+    # into a duplicated path. Preserve an existing slash before serving it.
+    class DirectoryHandler(server.handler_class):
+        def _find_path(self):
+            match = super()._find_path()
+            if match and self.request.path.endswith("/"):
+                return match[0].rstrip("/") + "/", match[1]
+            return match
+
+    server.handler_class = DirectoryHandler
+
+
+class TrainingResult:
+    def __init__(self):
+        self.token = uuid.uuid4().hex
+        self.record = None
+
+    def receive(self, request):
+        # One receipt per invocation; a previous run's file or token cannot
+        # authorize merging these raw profiles. Bound the structured payload.
+        try:
+            if not request.body or len(request.body) > 1024 * 1024:
+                raise ValueError("Missing or oversized training result")
+            record = json.loads(request.body)
+            if not isinstance(record, dict) or record.get("token") != self.token:
+                raise ValueError("Wrong training run")
+        except (ValueError, TypeError):
+            return 400, {"Content-Type": "application/json"}, '{"accepted":false}'
+        if self.record is not None:
+            return 409, {"Content-Type": "application/json"}, '{"accepted":false}'
+        self.record = record
+        return 200, {"Content-Type": "application/json"}, '{"accepted":true}'
+
+    def finish(self, returncode, path):
+        error = None
+        try:
+            if returncode is None:
+                raise ValueError("Training browser exceeded the one-hour limit")
+            if returncode != 0:
+                raise ValueError("Training browser exited unsuccessfully")
+            validate_training_result(self.record, self.token)
+        except ValueError as exc:
+            error = str(exc)
+        with open(path, "w") as output:
+            json.dump({"record": self.record, "processExit": returncode,
+                       "validationError": error}, output, indent=2, sort_keys=True)
+            output.write("\n")
+        return error


