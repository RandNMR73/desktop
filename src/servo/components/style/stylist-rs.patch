+    /// Cascade SVG highlight paint through the corresponding parent highlight.
+    #[cfg(feature = "gecko")]
+    pub fn compute_highlight_svg_style<E>(
+        &self,
+        guards: &StylesheetGuards,
+        element: E,
+        pseudo: &PseudoElement,
+        rule_inclusion: RuleInclusion,
+        originating_element_style: &ComputedValues,
+        highlight_parent: Option<&ComputedValues>,
+        is_probe: bool,
+        matching_fn: Option<&dyn Fn(&PseudoElement) -> bool>,
+    ) -> Option<Arc<ComputedValues>>
+    where
+        E: TElement,
+    {
+        debug_assert!(pseudo.is_lazy_painted_highlight_pseudo());
+        let inputs = self.lazy_pseudo_rules(
+            guards,
+            element,
+            originating_element_style,
+            pseudo,
+            is_probe && highlight_parent.is_none(),
+            rule_inclusion,
+            matching_fn,
+        )?;
+        let parent = originating_element_style.clone_with_highlight_parent(
+            highlight_parent,
+            self.device().default_computed_values(),
+        );
+        Some(self.compute_pseudo_element_style_with_inputs(
+            inputs,
+            pseudo,
+            guards,
+            Some(&parent),
+            Some(element),
+        ))
+    }
