+<%self:impl_trait style_struct_name="InheritedSVG" skip_longhands="fill stroke">
+    % for name in ("fill", "stroke"):
+    <% field = "m" + to_camel_case(name) %>
+    pub fn set_${name}(&mut self, v: longhands::${name}::computed_value::T) {
+        // Equal paint assignments retain their inherited initial state.
+        if self.${field} != v {
+            self.${field} = v;
+            self.${field}IsInitialPaint = false;
+        }
+    }
+
+    pub fn copy_${name}_from(&mut self, other: &Self) {
+        if self.${field} != other.${field} {
+            self.${field} = other.${field}.clone();
+            self.${field}IsInitialPaint = other.${field}IsInitialPaint;
+        }
+    }
+
+    pub fn reset_${name}(&mut self, other: &Self) {
+        self.copy_${name}_from(other);
+    }
+
+    #[inline]
+    pub fn get_${name}(&self) -> &longhands::${name}::computed_value::T {
+        &self.${field}
+    }
+
+    #[inline]
+    pub fn slow_clone_${name}(&self) -> longhands::${name}::computed_value::T {
+        self.${field}.clone()
+    }
+
+    pub fn ${name}_equals(&self, other: &Self) -> bool {
+        self.${field} == other.${field} &&
+            self.${field}IsInitialPaint == other.${field}IsInitialPaint
+    }
