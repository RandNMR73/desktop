+    /// Combine corresponding-parent highlight values with originating-element context.
+    pub fn clone_with_highlight_parent(
+        &self,
+        highlight_parent: Option<&ComputedValues>,
+        initial: &ComputedValues,
+    ) -> Arc<ComputedValues> {
+        use crate::values::computed::color::{Color, HighlightColor};
+        let parent = highlight_parent.unwrap_or(initial);
+        <% highlight_properties = PropertyRestrictions.highlight(data) %>
+        % for style_struct in data.style_structs:
+        <% properties = [p for p in style_struct.longhands if not p.logical and p.name in highlight_properties] %>
+        % if properties:
+        % if style_struct.inherited:
+        let mut ${style_struct.ident} = self.get_${style_struct.name_lower}().clone();
+        % else:
+        let mut ${style_struct.ident} = initial.get_${style_struct.name_lower}().clone();
+        % endif
+        % for property in properties:
+        % if property.name != "color":
+        ${style_struct.ident}.copy_${property.ident}_from(parent.get_${style_struct.name_lower}());
+        % endif
+        % endfor
+        % endif
+        % endfor
+        inherited_svg.mFillIsInitialPaint = parent.get_inherited_svg().mFillIsInitialPaint;
+        inherited_svg.mStrokeIsInitialPaint = parent.get_inherited_svg().mStrokeIsInitialPaint;
+        let color = highlight_parent.map_or(Color::CurrentColor, |parent| {
+            parent.get_inherited_text().mHighlightColor.first().map_or_else(
+                || Color::Absolute(parent.get_inherited_text().mColor),
+                |data| data.color.clone(),
+            )
+        });
+        let originating_color = self.get_inherited_text().mColor;
+        inherited_text.mColor = color.resolve_to_absolute(&originating_color);
+        inherited_text.mHighlightColor = crate::ArcSlice::from_iter(std::iter::once(
+            HighlightColor { color, originating_color }
+        ));
+        let paint_flags = ComputedValueFlags::HAS_AUTHOR_SPECIFIED_TEXT_COLOR
+            | ComputedValueFlags::HAS_AUTHOR_SPECIFIED_BORDER_BACKGROUND
+            | ComputedValueFlags::HAS_AUTHOR_SPECIFIED_TEXT_SHADOW;
+        Self::new(
+            None,
+            self.custom_properties.clone(),
+            self.attribute_references.clone(),
+            self.writing_mode,
+            self.effective_zoom,
+            (self.flags - paint_flags) | (parent.flags & paint_flags),
+            self.rules.clone(),
+            self.visited_style().map(|visited| {
+                visited.clone_with_highlight_parent(
+                    highlight_parent.map(|parent| parent.visited_style().unwrap_or(parent)),
+                    initial,
+                )
+            }),
+            % for style_struct in data.style_structs:
+            % if any(not p.logical and p.name in highlight_properties for p in style_struct.longhands):
+            Arc::new(${style_struct.ident}),
+            % elif style_struct.inherited:
+            unsafe { Arc::from_raw_addrefed(self.${style_struct.gecko_name} as *const _) },
+            % else:
+            unsafe { Arc::from_raw_addrefed(initial.${style_struct.gecko_name} as *const _) },
+            % endif
+            % endfor
+        ).into_outer()
+    }
