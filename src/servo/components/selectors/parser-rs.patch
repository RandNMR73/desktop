     #[test]
+    fn test_search_text_current_state() {
+        for (suffix, expected) in [
+            ("", [true, true]),
+            (":current", [false, true]),
+            (":not(:current)", [true, false]),
+            (":not(:not(:current))", [false, true]),
+            (":not(:current, :not(:current))", [false, false]),
+            (":is(:current, :not(:current))", [true, true]),
+            (":where(:current)", [false, true]),
+        ] {
+            let input = format!(".target::search-text{suffix}");
+            let list = parse(&input).unwrap();
+            for current in [false, true] {
+                let mut iter = list.slice()[0].iter();
+                assert!(matches!(
+                    iter.next(),
+                    Some(Component::PseudoElement(PseudoElement::SearchText))
+                ));
+                assert_eq!(
+                    iter.matches_for_stateless_pseudo_element(current),
+                    expected[current as usize],
+                    "{input}: {current}"
+                );
+            }
+        }
+        for suffix in [
+            ":hover", ":active", ":lang(en)", ":not(:hover)", ":current(*)", ".a", " div", "::after",
+        ] {
+            assert!(parse(&format!("::search-text{suffix}")).is_err(), "{suffix}");
+        }
+        assert!(parse("::before:current").is_err());
+        assert!(parse("::part(test)::search-text:current").is_ok());
+    }
+
