+fn get_highlight_svg_style<'le>(
+    context: &mut StyleContext<GeckoElement<'le>>,
+    element: GeckoElement<'le>,
+    pseudo: &PseudoElement,
+    rule_inclusion: RuleInclusion,
+    origin: Arc<ComputedValues>,
+    is_probe: bool,
+    cache: &mut HighlightStyleCache,
+) -> Option<Arc<ComputedValues>> {
+    let mut chain = SmallVec::<[(GeckoElement<'le>, Arc<ComputedValues>); 16]>::new();
+    let mut current = Some(element);
+    let mut parent = None;
+    while let Some(ancestor) = current {
+        let primary = if ancestor == element {
+            origin.clone()
+        } else {
+            let styled = if rule_inclusion == RuleInclusion::All {
+                ancestor
+                    .borrow_data()
+                    .and_then(|data| data.styles.get_primary().cloned())
+            } else {
+                None
+            };
+            styled.unwrap_or_else(|| {
+                resolve_style(context, ancestor, rule_inclusion, None, None)
+                    .primary()
+                    .clone()
+            })
+        };
+        let key = (ancestor.opaque(), pseudo.clone());
+        if let Some((cached_origin, cached_style)) = cache.get(&key)
+            && Arc::ptr_eq(cached_origin, &primary)
+        {
+            parent = cached_style.clone();
+            break;
+        }
+        chain.push((ancestor, primary));
+        current = ancestor.inheritance_parent();
+    }
+    let stylist = context.shared.stylist;
+    let matching_fn = |candidate: &PseudoElement| *candidate == *pseudo;
+    while let Some((ancestor, primary)) = chain.pop() {
+        parent = stylist.compute_highlight_svg_style(
+            &context.shared.guards,
+            ancestor,
+            pseudo,
+            rule_inclusion,
+            &primary,
+            parent.as_deref(),
+            true,
+            Some(&matching_fn),
+        );
+        cache.insert(
+            (ancestor.opaque(), pseudo.clone()),
+            (primary, parent.clone()),
+        );
+    }
+    if parent.is_some() || is_probe {
+        return parent;
+    }
+    stylist.compute_highlight_svg_style(
+        &context.shared.guards,
+        element,
+        pseudo,
+        rule_inclusion,
+        &origin,
+        None,
+        false,
+        Some(&matching_fn),
+    )
 }
 
