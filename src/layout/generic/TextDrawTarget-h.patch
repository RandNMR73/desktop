@@ -224,10 +233,46 @@

   IntSize GetSize() const override { return mSize; }

-  void AppendShadow(const wr::Shadow& aShadow, bool aInflate) {
+  void AppendShadow(const wr::Shadow& aShadow, bool aInflate,
+                    const Maybe<DeviceColor>& aDecorationColor = Nothing()) {
+    mTextShadows.AppendElement(TextShadow{
+        aShadow,
+        aDecorationColor ? wr::ToColorF(*aDecorationColor) : aShadow.color,
+        ClipRect(), aInflate});
+    mHasDecorationShadowColors |= aDecorationColor.isSome();
     mBuilder.PushShadow(mBoundsRect, ClipRect(), mBackfaceVisible, aShadow,
                         aInflate);
     mHasShadows = true;
+  }
+
+  void UseDecorationShadows(bool aDecorations) {
+    UpdateShadows(aDecorations, 0);
+  }
+
+  void UpdateShadows(bool aDecorations, int8_t aRotation) {
+    if (mTextShadows.IsEmpty()) {
+      return;
+    }
+    const bool changed =
+        mShadowRotation != aRotation ||
+        (mHasDecorationShadowColors && mDecorationShadows != aDecorations);
+    mShadowRotation = aRotation;
+    mDecorationShadows = aDecorations;
+    if (!changed) {
+      return;
+    }
+    mBuilder.PopAllShadows();
+    for (const auto& entry : mTextShadows) {
+      auto shadow = entry.mShadow;
+      if (aDecorations) {
+        shadow.color = entry.mDecorationColor;
+      } else if (aRotation) {
+        shadow.offset = {-aRotation * entry.mShadow.offset.y,
+                         aRotation * entry.mShadow.offset.x};
+      }
+      mBuilder.PushShadow(mBoundsRect, entry.mClip, mBackfaceVisible, shadow,
+                          entry.mInflate);
+    }
   }

