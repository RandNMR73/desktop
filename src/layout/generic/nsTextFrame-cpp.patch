+static int8_t TextDecorationShadowRotation(WritingMode aWritingMode) {
+  if (!aWritingMode.IsVertical()) {
+    return 0;
+  }
+  return aWritingMode.IsSideways() && !aWritingMode.IsVerticalRL() ? -1 : 1;
+}
+
+template <typename Callback>
+static void ForEachTextShadowOffset(const gfxTextRun* aTextRun,
+                                    const nsPoint& aOffset,
+                                    int8_t aDecorationRotation,
+                                    Callback&& aCallback) {
+  aCallback(aOffset);
+  bool left = aDecorationRotation < 0;
+  bool right = aDecorationRotation > 0;
+  if (aTextRun && aTextRun->IsVertical()) {
+    uint32_t count;
+    const auto* runs = aTextRun->GetGlyphRuns(&count);
+    for (uint32_t i = 0; i < count; ++i) {
+      left |= runs[i].IsSidewaysLeft();
+      right |= runs[i].IsSidewaysRight();
+    }
+  }
+  if (left) {
+    aCallback(nsPoint(aOffset.y, -aOffset.x));
+  }
+  if (right) {
+    aCallback(nsPoint(-aOffset.y, aOffset.x));
+  }
+}
+
+static nsRect TextShadowInkBounds(const nsRect& aInk,
+                                  Span<const StyleSimpleShadow> aShadows,
+                                  nsPresContext* aPresContext,
+                                  const gfxTextRun* aTextRun,
+                                  int8_t aDecorationRotation) {
+  nsRect result = aInk;
+  for (const auto& shadow : aShadows) {
+    const nsMargin blur = nsContextBoxBlur::GetBlurRadiusMargin(
+        shadow.blur.ToAppUnits(), aPresContext->AppUnitsPerDevPixel());
+    ForEachTextShadowOffset(
+        aTextRun,
+        nsPoint(shadow.horizontal.ToAppUnits(), shadow.vertical.ToAppUnits()),
+        aDecorationRotation, [&](const nsPoint& offset) {
+          nsRect bounds = aInk + offset;
+          bounds.Inflate(blur);
+          result.UnionRect(result, bounds);
+        });
+  }
+  return result;
+}
