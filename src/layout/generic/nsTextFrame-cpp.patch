+/* static */
+void nsTextFrame::ResolveSelectionColors(
+    Span<const SelectionType> aTypes, Span<const RefPtr<nsAtom>> aNames,
+    Span<const TextRangeStyle> aRangeStyles, nsTextPaintStyle& aTextPaintStyle,
+    nsTArray<SelectionColors>& aColors) {
+  MOZ_ASSERT(aTypes.Length() == aNames.Length());
+  MOZ_ASSERT(aTypes.Length() == aRangeStyles.Length());
+  aColors.Clear();
+  auto underlying = aTextPaintStyle.GetBaseHighlightColors();
+  for (size_t i = 0; i < aTypes.Length(); ++i) {
+    auto colors = GetSelectionTextColors(aTypes[i], aNames[i], aTextPaintStyle,
+                                         aRangeStyles[i], underlying);
+    if (colors.mOverridesForeground) {
+      if (colors.mLayerForeground) {
+        underlying = *colors.mLayerForeground;
+      } else {
+        const auto color = colors.mAbsoluteForeground.valueOr(
+            StyleAbsoluteColor::FromColor(colors.mForeground));
+        underlying = {color, color};
+      }
+    }
+    if (!colors.mLayerForeground) {
+      colors.mLayerForeground = Some(underlying);
+    }
+    aColors.AppendElement(std::move(colors));
+  }
 }

