+Maybe<nsTextPaintStyle::HighlightLayerColors>
+nsTextPaintStyle::GetHighlightLayerColors(
+    SelectionType aSelectionType, nsAtom* aHighlightName,
+    Span<const StyleAbsoluteColor> aUnderlyingColors) {
+  MOZ_ASSERT(aUnderlyingColors.Length() == 2);
+  auto style =
+      GetComputedStyleForSelectionPseudo(aSelectionType, aHighlightName);
+  if (!style || style->StyleText()->mHighlightColor.IsEmpty() ||
+      ((aSelectionType == SelectionType::eNormal ||
+        aSelectionType == SelectionType::eTargetText ||
+        aSelectionType == SelectionType::eFind ||
+        aSelectionType == SelectionType::eSpellCheck) &&
+       !style->HasAuthorSpecifiedTextColor() &&
+       !style->HasAuthorSpecifiedBorderOrBackground())) {
+    return Nothing();
+  }
+  HighlightColorPair svgOrigin;
+  if (aSelectionType == SelectionType::eNormal &&
+      mFrame->IsInSVGTextSubtree()) {
+    svgOrigin = GetBaseHighlightColors();
+    aUnderlyingColors = svgOrigin;
+  }
+  auto foregroundForStyle = [&](const ComputedStyle& aStyle, size_t aIndex) {
+    const auto& colors = aStyle.StyleText()->mHighlightColor;
+    return !colors.IsEmpty() && colors.AsSpan()[0].color.IsCurrentColor()
+               ? aUnderlyingColors[aIndex]
+               : aStyle.StyleText()->mColor;
+  };
+  const auto* visitedStyle = style->GetStyleIfVisited();
+  const HighlightColorPair layerForeground = {
+      foregroundForStyle(*style, 0),
+      foregroundForStyle(visitedStyle ? *visitedStyle : *style, 1)};
+  const auto foreground =
+      ResolveHighlightVisitedColor(*style, foregroundForStyle);
+  const auto background = ResolveHighlightVisitedColor(
+      *style, [&](const ComputedStyle& aStyle, size_t aIndex) {
+        const auto& color = aStyle.StyleBackground()->mBackgroundColor;
+        return color.ResolveColor(color.IsCurrentColor()
+                                      ? layerForeground[aIndex]
+                                      : aStyle.StyleText()->mColor);
+      });
+  return Some(HighlightLayerColors{layerForeground, foreground, background,
+                                   foreground.ToColor(mFrame),
+                                   background.ToColor(mFrame)});
+}
+
+nsTextPaintStyle::HighlightColorPair
+nsTextPaintStyle::GetBaseHighlightColors() {
+  auto resolve = [&](const ComputedStyle& aStyle) {
+    if (mFrame->IsInSVGTextSubtree()) {
+      return aStyle.StyleText()->mColor;
+    }
+    return aStyle.StyleText()->mWebkitTextFillColor.ResolveColor(
+        aStyle.StyleText()->mColor);
+  };
+  const auto* style = mFrame->Style();
+  const auto* visitedStyle = style->GetStyleIfVisited();
+  return {resolve(*style), resolve(visitedStyle ? *visitedStyle : *style)};
+}
+
+bool nsTextPaintStyle::MayHaveHighlightBackground(SelectionType aSelectionType,
+                                                  nsAtom* aHighlightName) {
+  auto style =
+      GetComputedStyleForSelectionPseudo(aSelectionType, aHighlightName);
+  if (!style) {
+    return false;
+  }
+  const auto& background = style->StyleBackground()->mBackgroundColor;
+  return !background.IsAbsolute() || background.AsAbsolute().alpha != 0.0f;
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetHighlightDecorationColor(
+    const ComputedStyle& aStyle, Span<const StyleAbsoluteColor> aLayerColors) {
+  MOZ_ASSERT(aLayerColors.Length() == 2);
+  return ResolveHighlightVisitedColor(
+      aStyle, [&](const ComputedStyle& aStyle, size_t aIndex) {
+        const auto& color = aStyle.StyleTextReset()->mTextDecorationColor;
+        return color.ResolveColor(color.IsCurrentColor()
+                                      ? aLayerColors[aIndex]
+                                      : aStyle.StyleText()->mColor);
+      });
+}
+
+StyleAbsoluteColor nsTextPaintStyle::ResolveHighlightColor(
+    const StyleColor& aColor, Span<const StyleAbsoluteColor> aLayerColors,
+    bool aLinkIsVisited) {
+  MOZ_ASSERT(aLayerColors.Length() == 2);
+  const StyleAbsoluteColor colors[] = {aColor.ResolveColor(aLayerColors[0]),
+                                       aColor.ResolveColor(aLayerColors[1])};
+  auto result = colors[aLinkIsVisited && colors[1].alpha != 0.0f ? 1 : 0];
+  result.alpha = colors[0].alpha;
+  return result;
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetAbsoluteCurrentColor() {
+  return ResolveAbsoluteColor(
+      mFrame->Style()->GetVisitedDependentAbsoluteColor(&nsStyleText::mColor),
+      GetCurrentColor());
+}
+
+nscolor nsTextPaintStyle::GetCurrentColor() {
+  return nsLayoutUtils::GetTextColor(mFrame, &nsStyleText::mColor);
+}
