+StyleAbsoluteColor nsTextPaintStyle::ResolveAbsoluteColor(
+    const StyleAbsoluteColor& aColor, nscolor aResolvedColor) {
+  return ResolveAbsoluteColor(mFrame, aColor, aResolvedColor);
+}
+
+StyleAbsoluteColor nsTextPaintStyle::ResolveAbsoluteColor(
+    nsIFrame* aFrame, const StyleAbsoluteColor& aColor,
+    nscolor aResolvedColor) {
+  if (gfxPlatform::UsesNativeDisplayP3() &&
+      !zen::nsZenBoostsBackend::HasStyleColorFilter(aFrame) &&
+      aColor.ToColor(nullptr) == aResolvedColor) {
+    return aColor;
+  }
+  return StyleAbsoluteColor::FromColor(aResolvedColor);
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetAbsoluteTextColor(
+    nscolor aResolvedColor) {
+  if (mFrame->IsInSVGTextSubtree()) {
+    if (!mResolveColors || !mFrame->StyleSVG()->mFill.kind.IsColor()) {
+      return StyleAbsoluteColor::FromColor(aResolvedColor);
+    }
+    return ResolveAbsoluteColor(
+        mFrame->Style()->GetVisitedDependentAbsoluteColor(&nsStyleSVG::mFill),
+        aResolvedColor);
+  }
+  return ResolveAbsoluteColor(mFrame->Style()->GetVisitedDependentAbsoluteColor(
+                                  &nsStyleText::mWebkitTextFillColor),
+                              aResolvedColor);
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetAbsoluteTextDecorationColor(
+    nsIFrame* aFrame, const ComputedStyle& aStyle, nscolor* aResolvedColor) {
+  auto decorationColor = [](const ComputedStyle& aContext) {
+    auto color = aContext.StyleTextReset()->mTextDecorationColor;
+    const auto* text = aContext.StyleText();
+    if (color.IsCurrentColor()) {
+      const auto& stroke = text->mWebkitTextStrokeColor;
+      color = text->mWebkitTextFillColor;
+      if (text->mWebkitTextStrokeWidth && !stroke.IsCurrentColor() &&
+          stroke.ResolveColor(text->mColor).alpha != 0.0f) {
+        color = stroke;
+      }
+    }
+    return color.ResolveColor(text->mColor);
+  };
+  const auto unvisited = decorationColor(aStyle);
+  auto absoluteColor = unvisited;
+  nscolor color = unvisited.ToColor(aFrame);
+  if (const auto* visitedStyle = aStyle.GetStyleIfVisited()) {
+    const auto visited = decorationColor(*visitedStyle);
+    const StyleAbsoluteColor colors[] = {unvisited, visited};
+    absoluteColor = colors[aStyle.RelevantLinkVisited() ? 1 : 0];
+    absoluteColor.alpha = unvisited.alpha;
+    nscolor resolvedColors[] = {color, visited.ToColor(aFrame)};
+    color = ComputedStyle::CombineVisitedColors(resolvedColors,
+                                                aStyle.RelevantLinkVisited());
+  }
+  *aResolvedColor = nsLayoutUtils::DarkenColorIfNeeded(aFrame, color);
+  return ResolveAbsoluteColor(aFrame, absoluteColor, *aResolvedColor);
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetAbsoluteSelectionColor(
+    SelectionType aSelectionType, nsAtom* aHighlightName,
+    nscolor aResolvedColor, bool aBackground) {
+  if (aSelectionType == SelectionType::eNone && !aBackground) {
+    return GetAbsoluteTextColor(aResolvedColor);
+  }
+  if (aSelectionType == SelectionType::eURLSecondary && !aBackground) {
+    auto color = GetAbsoluteTextColor(GetTextColor());
+    color.alpha = 178.0f / 255.0f;
+    return color;
+  }
+  auto style =
+      GetComputedStyleForSelectionPseudo(aSelectionType, aHighlightName);
+  if (!style || ((aSelectionType == SelectionType::eNormal ||
+                  aSelectionType == SelectionType::eTargetText ||
+                  aSelectionType == SelectionType::eFind ||
+                  aSelectionType == SelectionType::eSpellCheck) &&
+                 !style->HasAuthorSpecifiedTextColor() &&
+                 !style->HasAuthorSpecifiedBorderOrBackground())) {
+    return StyleAbsoluteColor::FromColor(aResolvedColor);
+  }
+  if (aBackground) {
+    return ResolveAbsoluteColor(style->GetVisitedDependentAbsoluteColor(
+                                    &nsStyleBackground::mBackgroundColor),
+                                aResolvedColor);
+  }
+  return ResolveAbsoluteColor(
+      aSelectionType == SelectionType::eTargetText
+          ? style->GetVisitedDependentAbsoluteColor(
+                &nsStyleText::mWebkitTextFillColor)
+          : style->GetVisitedDependentAbsoluteColor(&nsStyleText::mColor),
+      aResolvedColor);
+}
+
+StyleAbsoluteColor nsTextPaintStyle::GetAbsoluteWebkitTextStrokeColor(
+    nscolor aResolvedColor) {
+  if (mFrame->IsInSVGTextSubtree()) {
+    return StyleAbsoluteColor::FromColor(aResolvedColor);
+  }
+  return ResolveAbsoluteColor(
+      mFrame->StyleText()->mWebkitTextStrokeColor.ResolveColor(
+          mFrame->StyleText()->mColor),
+      aResolvedColor);
+}
+
+template <typename ResolveColor>
+static StyleAbsoluteColor ResolveHighlightVisitedColor(
+    const ComputedStyle& aStyle, ResolveColor aResolve) {
+  const auto unvisited = aResolve(aStyle, 0);
+  const auto* visitedStyle = aStyle.GetStyleIfVisited();
+  const StyleAbsoluteColor colors[] = {
+      unvisited, aResolve(visitedStyle ? *visitedStyle : aStyle, 1)};
+  const bool useVisited =
+      aStyle.RelevantLinkVisited() && colors[1].alpha != 0.0f;
+  auto result = colors[useVisited ? 1 : 0];
+  result.alpha = unvisited.alpha;
+  return result;
+}
