+bool nsTextPaintStyle::GetBuiltinHighlightColors(SelectionType aType,
+                                                 nscolor* aForeColor,
+                                                 nscolor* aBackColor) {
+  auto style = GetComputedStyleForSelectionPseudo(aType, nullptr);
+  if (!style || (!style->HasAuthorSpecifiedTextColor() &&
+                 !style->HasAuthorSpecifiedBorderOrBackground())) {
+    return false;
+  }
+  *aForeColor = style->GetVisitedDependentColor(&nsStyleText::mColor, mFrame);
+  *aBackColor = style->GetVisitedDependentColor(
+      &nsStyleBackground::mBackgroundColor, mFrame);
+  return true;
+}
