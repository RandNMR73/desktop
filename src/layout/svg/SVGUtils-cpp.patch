+static StyleAbsoluteColor ResolveHighlightSVGPaintColor(
+    const ComputedStyle& aStyle, StyleSVGPaint nsStyleSVG::* aFillOrStroke,
+    nscolor aDefaultContextFallbackColor,
+    Span<const StyleAbsoluteColor> aHighlightColors) {
+  MOZ_ASSERT(aHighlightColors.Length() == 2);
+  const auto& paint = aStyle.StyleSVG()->*aFillOrStroke;
+  if (!paint.kind.IsColor()) {
+    if (paint.fallback.IsColor()) {
+      return paint.fallback.AsColor().ResolveColor(aHighlightColors[0]);
+    }
+    return StyleAbsoluteColor::FromColor(paint.kind.IsPaintServer()
+                                             ? NS_RGBA(0, 0, 0, 0)
+                                             : aDefaultContextFallbackColor);
+  }
+  const auto unvisited = paint.kind.AsColor().ResolveColor(aHighlightColors[0]);
+  const auto* visitedStyle = aStyle.GetStyleIfVisited();
+  const auto& visitedPaint =
+      visitedStyle ? visitedStyle->StyleSVG()->*aFillOrStroke : paint;
+  if (!visitedPaint.kind.IsColor()) {
+    return unvisited;
+  }
+  const auto visited =
+      visitedPaint.kind.AsColor().ResolveColor(aHighlightColors[1]);
+  const StyleAbsoluteColor colors[] = {unvisited, visited};
+  auto result =
+      colors[aStyle.RelevantLinkVisited() && visited.alpha != 0.0f ? 1 : 0];
+  result.alpha = unvisited.alpha;
+  return result;
+}
