+DeviceColor SVGUtils::GetFallbackOrPaintDeviceColor(
+    const ComputedStyle& aStyle, StyleSVGPaint nsStyleSVG::* aFillOrStroke,
+    nscolor aDefaultContextFallbackColor, const nsIFrame* aFrame,
+    Span<const StyleAbsoluteColor> aHighlightColors) {
+  if (!aHighlightColors.IsEmpty()) {
+    const auto color = ResolveHighlightSVGPaintColor(
+        aStyle, aFillOrStroke, aDefaultContextFallbackColor, aHighlightColors);
+    return gfxPlatform::UsesNativeDisplayP3()
+               ? ToDeviceColor(color, aFrame)
+               : ToDeviceColor(color.ToColor(aFrame));
+  }
+  if (!gfxPlatform::UsesNativeDisplayP3()) {
+    return ToDeviceColor(GetFallbackOrPaintColor(
+        aStyle, aFillOrStroke, aDefaultContextFallbackColor, aFrame));
+  }
+  const auto& paint = aStyle.StyleSVG()->*aFillOrStroke;
+  auto color = StyleAbsoluteColor::FromColor(NS_RGBA(0, 0, 0, 0));
+  switch (paint.kind.tag) {
+    case StyleSVGPaintKind::Tag::PaintServer:
+      if (paint.fallback.IsColor()) {
+        color =
+            paint.fallback.AsColor().ResolveColor(aStyle.StyleText()->mColor);
+      }
+      break;
+    case StyleSVGPaintKind::Tag::ContextStroke:
+    case StyleSVGPaintKind::Tag::ContextFill:
+      color = paint.fallback.IsColor()
+                  ? paint.fallback.AsColor().ResolveColor(
+                        aStyle.StyleText()->mColor)
+                  : StyleAbsoluteColor::FromColor(aDefaultContextFallbackColor);
+      break;
+    default:
+      color = paint.kind.AsColor().ResolveColor(aStyle.StyleText()->mColor);
+      break;
+  }
+  if (const auto* visitedStyle = aStyle.GetStyleIfVisited()) {
+    const auto& visitedPaint = visitedStyle->StyleSVG()->*aFillOrStroke;
+    if (paint.kind.IsColor() && visitedPaint.kind.IsColor()) {
+      auto visited = visitedPaint.kind.AsColor().ResolveColor(
+          visitedStyle->StyleText()->mColor);
+      visited.alpha = color.alpha;
+      const StyleAbsoluteColor colors[] = {color, visited};
+      color = colors[aStyle.RelevantLinkVisited() ? 1 : 0];
+    }
+  }
+  return ToDeviceColor(color, aFrame);
+}
