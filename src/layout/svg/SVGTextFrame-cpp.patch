+void SVGTextDrawPathCallbacks::PaintShadowMask(
+    const Pattern& aPattern, Path* aPath, const StrokeOptions* aStrokeOptions) {
+  ColorPattern shadow(mDeviceColor ? *mDeviceColor : ToDeviceColor(mColor));
+  DrawTarget* target = mContext.GetDrawTarget();
+  const bool hasMask = aPattern.GetType() != PatternType::COLOR;
+  if (hasMask) {
+    Rect bounds = aStrokeOptions ? aPath->GetStrokedBounds(
+                                       *aStrokeOptions, target->GetTransform())
+                                 : aPath->GetBounds(target->GetTransform());
+    bounds.Inflate(1.0f);
+    bounds = bounds.Intersect(
+        ToRect(mContext.GetClipExtents(gfxContext::eDeviceSpace)));
+    if (bounds.IsEmpty()) {
+      return;
+    }
+    target->PushLayer(false, 1.0f, nullptr, Matrix(), RoundedOut(bounds));
+  }
+  const Pattern& paint = hasMask ? aPattern : shadow;
+  if (aStrokeOptions) {
+    target->Stroke(aPath, paint, *aStrokeOptions);
+  } else {
+    target->Fill(aPath, paint);
+  }
+  if (hasMask) {
+    target->FillRect(ToRect(mContext.GetClipExtents()), shadow,
+                     DrawOptions(1.0f, CompositionOp::OP_IN));
+    target->PopLayer();
   }
 }

