+void SVGTextDrawPathCallbacks::NotifyBeforeShadow(gfxContext& aContext,
+                                                  const Point& aOffset) {
+  gfxMatrix inverseRun = mOriginalContext.CurrentMatrixDouble();
+  gfxMatrix shadowRun = aContext.CurrentMatrixDouble();
+  shadowRun.PreTranslate(gfxPoint(aOffset.x, aOffset.y));
+  mCanvasTM = inverseRun.Invert() ? mOriginalCanvasTM * inverseRun * shadowRun
+                                  : shadowRun;
+  mContext = &aContext;
+}
+
+void SVGTextDrawPathCallbacks::NotifyAfterShadow() {
+  mContext = &mOriginalContext;
+  mCanvasTM = mOriginalCanvasTM;
+}
