+template <typename Func>
+static StyleAbsoluteColor GetVisitedDependentAbsoluteColorInternal(
+    const ComputedStyle& aStyle, Func aColorFunc) {
+  const auto unvisited = aColorFunc(aStyle);
+  const auto* visitedStyle = aStyle.GetStyleIfVisited();
+  if (!visitedStyle) {
+    return unvisited;
+  }
+  const auto visited = aColorFunc(*visitedStyle);
+  const StyleAbsoluteColor colors[] = {unvisited, visited};
+  const bool useVisited = aStyle.RelevantLinkVisited();
+  auto result = colors[useVisited ? 1 : 0];
+  // A visited link must always use its unvisited alpha.
+  result.alpha = unvisited.alpha;
+  return result;
 }

