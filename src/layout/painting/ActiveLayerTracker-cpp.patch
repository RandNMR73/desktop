+/* static */
+bool ActiveLayerTracker::IsOpacityChanging(nsIFrame* aFrame) {
+  if (LayerActivity* layerActivity = GetLayerActivity(aFrame)) {
+    if (layerActivity->mRestyleCounts[LayerActivity::ACTIVITY_OPACITY] >= 2) {
+      return true;
+    }
+  }
+  return nsLayoutUtils::HasEffectiveAnimation(
+      aFrame, nsCSSPropertyIDSet::OpacityProperties());
