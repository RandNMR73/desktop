+// Zen: whether every compositor animation of this frame's transform is a 2D
+// translation at every keyframe and in its base style, with no individual
+// transform property or motion path. See nsDisplayTransform::
+// CreateWebRenderCommands.
+static bool IsTranslation2D(const Matrix4x4& aMatrix) {
+  Matrix matrix;
+  return aMatrix.Is2D(&matrix) && matrix.IsTranslation();
+}
+
+static bool HasOnlyTranslationTransformAnimations(const nsIFrame* aFrame) {
+  const nsStyleDisplay* display = aFrame->StyleDisplay();
+  if (!display->mTranslate.IsNone() || !display->mRotate.IsNone() ||
+      !display->mScale.IsNone() || !display->mOffsetPath.IsNone()) {
+    return false;
+  }
+  const nsCSSPropertyIDSet transformLike =
+      nsCSSPropertyIDSet::TransformLikeProperties();
+  const nsTArray<RefPtr<dom::Animation>> animations =
+      EffectCompositor::GetAnimationsForCompositor(aFrame, transformLike);
+  if (animations.IsEmpty()) {
+    return false;
+  }
+  nsStyleTransformMatrix::TransformReferenceBox refBox(aFrame);
+  const float appUnitsPerDevPixel = aFrame->PresContext()->AppUnitsPerDevPixel();
+  const StyleZoom zoom = aFrame->Style()->EffectiveZoom();
+  auto isTranslation = [&](const AnimationValue& aValue) {
+    return IsTranslation2D(nsStyleTransformMatrix::ReadTransforms(
+        StyleTranslate::None(), StyleRotate::None(), StyleScale::None(),
+        nullptr, aValue.GetTransformProperty(), refBox, appUnitsPerDevPixel,
+        zoom, nsStyleTransformMatrix::Zoomed::Yes));
+  };
+  for (dom::Animation* animation : animations) {
+    const dom::KeyframeEffect* effect =
+        animation->GetEffect() ? animation->GetEffect()->AsKeyframeEffect()
+                               : nullptr;
+    if (!effect) {
+      return false;
+    }
+    for (const AnimationProperty& property : effect->Properties()) {
+      if (property.mProperty.mId != eCSSProperty_transform) {
+        if (transformLike.HasProperty(property.mProperty.mId)) {
+          return false;
+        }
+        continue;
+      }
+      const AnimationValue base = effect->BaseStyle(property.mProperty);
+      if (!base.IsNull() && !isTranslation(base)) {
+        return false;
+      }
+      for (const AnimationPropertySegment& segment : property.mSegments) {
+        if (!segment.HasReplaceableValues() ||
+            !isTranslation(segment.mFromValue) ||
+            !isTranslation(segment.mToValue)) {
+          return false;
+        }
+      }
+    }
+  }
+  return true;
+}
