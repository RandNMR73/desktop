 void PresShell::UpdateCanvasBackground() {
   mCanvasBackground = ComputeCanvasBackground();
+}
+
+SingleCanvasBackground::SingleCanvasBackground(nscolor aColor,
+                                               bool aCSSSpecified)
+    : SingleCanvasBackground(aColor, aCSSSpecified, ToDeviceColor(aColor)) {}
+
+SingleCanvasBackground::SingleCanvasBackground(
+    nscolor aColor, bool aCSSSpecified, const gfx::DeviceColor& aDeviceColor)
+    : mColor(aColor),
+      mCSSSpecified(aCSSSpecified),
+      mDeviceColor(aDeviceColor) {}
+
+void SingleCanvasBackground::CompositeOver(nscolor aBackstopColor) {
+  mColor = NS_ComposeColors(aBackstopColor, mColor);
+  if (!gfxPlatform::UsesNativeDisplayP3()) {
+    mDeviceColor = ToDeviceColor(mColor);
+    return;
+  }
+  if (mDeviceColor.a == 1.0f || NS_GET_A(aBackstopColor) == 0) {
+    return;
+  }
+  const auto foreground = StyleAbsoluteColor{
+      {mDeviceColor.r, mDeviceColor.g, mDeviceColor.b}, mDeviceColor.a,
+      StyleColorSpace::DisplayP3, {0}}.ToColorSpace(StyleColorSpace::Srgb);
+  const auto backstop = StyleAbsoluteColor::FromColor(aBackstopColor);
+  const float backstopAlpha = backstop.alpha * (1.0f - foreground.alpha);
+  const float alpha = foreground.alpha + backstopAlpha;
+  if (alpha == 0.0f) {
+    mDeviceColor = gfx::DeviceColor();
+    return;
+  }
+  const float foregroundWeight = foreground.alpha / alpha;
+  const float backstopWeight = backstopAlpha / alpha;
+  // Chromium precomposes the root group in extended sRGB before output conversion.
+  const auto combined = StyleAbsoluteColor::SrgbLegacy(
+      foreground.components._0 * foregroundWeight +
+          backstop.components._0 * backstopWeight,
+      foreground.components._1 * foregroundWeight +
+          backstop.components._1 * backstopWeight,
+      foreground.components._2 * foregroundWeight +
+          backstop.components._2 * backstopWeight, alpha);
+  mDeviceColor = ToDeviceColor(combined, nullptr);
 }

