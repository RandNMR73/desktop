+bool nsCaret::UsesNativeCommandCaret(nsIFrame* aFrame) {
+#ifdef XP_MACOSX
+  nsIContent* content = aFrame->GetContent();
+  if (!content || !content->NodePrincipal()->IsSystemPrincipal()) {
+    return false;
+  }
+  const nsIContent* input =
+      content->GetClosestNativeAnonymousSubtreeRootParentOrHost();
+  if (!input || !input->IsHTMLElement(nsGkAtoms::input) ||
+      !input->AsElement()->AttrValueIs(kNameSpaceID_None, nsGkAtoms::id,
+                         u"urlbar-input"_ns, eCaseMatters)) {
+    return false;
+  }
+  const Element* bar = content->OwnerDoc()->GetElementById(u"urlbar"_ns);
+  return bar && bar->HasAttr(kNameSpaceID_None, nsGkAtoms::open);
+#else
+  return false;
+#endif
+}
