 // Available from 10.13 onwards; test availability at runtime before using
@@ -416,13 +417,36 @@ void GetHumanReadableInstantiatorStr(nsAString& aResult) {
   // For ATs that don't request `AXEnhancedUserInterface` we need to enable
   // accessibility when a role is fetched. Not ideal, but this is needed
   // for such services as Voice Control.
+  //
+  // Zen: window managers, launchers and automation tools (yabai, Raycast,
+  // screen readers of window titles, etc.) query the application role
+  // constantly. Upstream turns the whole web accessibility engine on for any
+  // such query, which costs ~25% on DOM-heavy pages. Match Chromium/Arc: only
+  // auto-enable on a role query when a known Apple assistive technology is
+  // active. Other clients can opt in explicitly via AXEnhancedUserInterface or
+  // AXManualAccessibility. Set accessibility.mac.enable_on_any_role_query to
+  // restore upstream behavior.
   if (!mozilla::a11y::sA11yShouldBeEnabled) {
-    [self accessibilitySetValue:@YES forAttribute:@"AXEnhancedUserInterface"];
+    bool enable = mozilla::Preferences::GetBool(
+        "accessibility.mac.enable_on_any_role_query", false);
+    if (!enable) {
+      auto [clients, _] = mozilla::a11y::GetClients();
+      enable = !clients.contains(mozilla::a11y::Client::Unknown);
+    }
+    if (enable) {
+      [self accessibilitySetValue:@YES
+                     forAttribute:@"AXEnhancedUserInterface"];
+    }
   }
   return [super accessibilityRole];
 }
 
