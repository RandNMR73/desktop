+    def test_included_preferences_are_build_dependencies(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source = root / "prefs.yaml"
+            included = root / "nested.inc"
+            source.write_text("#include nested.inc\n")
+            included.write_text(
+                "- name: test.included\n  type: bool\n"
+                "  value: false\n  mirror: always\n"
+            )
+            output = root / "generated" / "init" / "StaticPrefListAll.h"
+            output.parent.mkdir(parents=True)
+            with patch.dict(
+                "os.environ", {"TOPSRCDIR": directory, "GECKO_PATH": directory}
+            ):
+                with output.open("w") as fd:
+                    dependencies = emit_code(fd, str(source))
+            self.assertEqual({str(source), str(included)}, dependencies)

